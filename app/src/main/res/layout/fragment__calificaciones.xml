<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context="Ventana.Profesor.Fragment_Calificaciones">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="30dp">

        <Spinner
            android:id="@+id/spinnerCurso"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spinnerAlumno"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <Spinner
            android:id="@+id/spinnerTrimestre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <ListView
            android:id="@+id/listNotas"
            android:layout_width="341dp"
            android:layout_height="199dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Entregas pendientes de calificar"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEntregasPendientes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/tvSinEntregas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Este alumno no tiene entregas pendientes"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnAgregarNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Agregar Nota" />

    </LinearLayout>

</FrameLayout>