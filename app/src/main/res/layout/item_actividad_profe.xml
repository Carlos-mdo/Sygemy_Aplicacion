<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="28dp"
        android:paddingVertical="24dp">

        <TextView
            android:text="Título"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#673AB7"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Ej: Parcial unidad 3"
            android:backgroundTint="#673AB7" />

        <TextView
            android:text="Descripción"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#673AB7"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="Descripción de la actividad"
            android:minLines="3"
            android:backgroundTint="#673AB7" />

        <TextView
            android:text="Fecha"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#673AB7"
            android:textStyle="bold"
            android:textSize="13sp" />

        <EditText
            android:id="@+id/etFecha"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="DD/MM/AAAA"
            android:inputType="date"
            android:backgroundTint="#673AB7" />

        <TextView
            android:text="Trimestre"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:textColor="#673AB7"
            android:textStyle="bold"
            android:textSize="13sp" />

        <Spinner
            android:id="@+id/spinnerTrimestreAct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="20dp"
            android:background="#E0D8F0" />

        <TextView
            android:text="Adjuntar archivo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#673AB7"
            android:textStyle="bold"
            android:textSize="13sp" />

        <TextView
            android:text="Pegar enlace:"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textSize="12sp"
            android:textColor="#888888" />

        <EditText
            android:id="@+id/etEnlace"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:hint="https://..."
            android:inputType="textUri"
            android:backgroundTint="#673AB7" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="14dp">

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0D8F0" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  O  "
                android:textColor="#9B93AC"
                android:textSize="12sp" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="#E0D8F0" />

        </LinearLayout>

        <Button
            android:id="@+id/btnSelecArchi"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Seleccionar archivo"
            android:textColor="#673AB7"
            android:textAllCaps="false"
            android:drawableStart="@android:drawable/ic_menu_add"
            android:drawablePadding="8dp"
            android:drawableTint="#673AB7"
            style="?attr/materialButtonOutlinedStyle" />

        <LinearLayout
            android:id="@+id/layoutArchiSelec"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#F4F0FA"
            android:padding="10dp"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@android:drawable/ic_menu_agenda"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/tvNomArchi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="archivo.pdf"
                android:textSize="13sp"
                android:textColor="#4A4A4A"
                android:ellipsize="middle"
                android:singleLine="true" />

            <ImageButton
                android:id="@+id/btnEliminaArchi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Eliminar archivo" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>