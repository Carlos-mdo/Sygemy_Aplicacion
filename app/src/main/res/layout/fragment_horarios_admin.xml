<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar horario"
            android:textColor="#1A1A1A"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Curso"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="8dp" />

        <Spinner
            android:id="@+id/spinCursoHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Materia"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <EditText
            android:id="@+id/etMateriaHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej: Matematica"
            android:inputType="text"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profesor"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinProfesorHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dia"
            android:textColor="#777777"
            android:textSize="13sp"
            android:layout_marginTop="16dp" />

        <Spinner
            android:id="@+id/spinDiaHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginEnd="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora inicio"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etHoraInicioHorario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="09:00"
                    android:inputType="time"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="8dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hora fin"
                    android:textColor="#777777"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etHoraFinHorario"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="11:00"
                    android:inputType="time"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </LinearLayout>

        <Button
            android:id="@+id/btnGuardarHorario"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar horario"
            android:backgroundTint="#5B4B8A"
            android:textColor="#FFFFFF"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>